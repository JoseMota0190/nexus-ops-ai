# === LLM (TokenFactory / AMD) ===
# Modo mock: true = respuestas locales, sin llamar a ningún modelo (NO gasta créditos)
USE_MOCK=true

# Endpoint compatible con OpenAI (TokenFactory de AMD). Solo se usa si USE_MOCK=false.
# Lo obtenés del notebook de notebooks.amd.com/tokenfactory
LLM_BASE_URL=https://notebooks.amd.com/tokenfactory/v1
LLM_API_KEY=pon-aqui-tu-api-key
LLM_MODEL=pon-aqui-el-modelo-del-catalogo

# Límite de reintentos ante salida JSON inválida (máx. recomendado: 2)
LLM_MAX_RETRIES=2

# === Evolus ===
EVOLUS_ENABLED=false
EVOLUS_API_BASE=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=

# === Simulación ===
# Semilla para reproducibilidad
SIM_SEED=42
# Jornada real (min) y duración visual (s) -> velocidad = JORNADA_REAL_MIN*60 / JORNADA_VISUAL_SEG
JORNADA_REAL_MIN=480
JORNADA_VISUAL_SEG=240
TECNICOS=10
VISITAS_POR_TECNICO=3
