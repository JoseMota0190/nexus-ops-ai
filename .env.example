# ============================================================
# Nexus Alarm — variables de entorno
# Copiá este archivo como `.env` y completalo.  NUNCA se commitea `.env`.
# ============================================================

# === Cerebro LLM (Nebius Token Factory) ===
# true  = respuestas locales, sin llamar a ningún modelo (NO gasta créditos)
# false = usa Nebius de verdad (obligatorio para la demo de la hackathon)
USE_MOCK=true

# Endpoint compatible con OpenAI de Nebius Token Factory.
# La cuenta se crea en https://tokenfactory.nebius.com/
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1

# La API key se genera en el panel de Nebius (empieza con "nvapi-").
LLM_API_KEY=

# Router de modelos: el jurado premia usar un modelo grande para razonar
# y uno liviano para las llamadas del día a día.
# Razonamiento: agente "gerente" y los informes de sector.
LLM_MODEL_REASONING=nvidia/Nemotron-3.5-Super-VL
# Alto volumen: teleoperador, operador, agenda, técnicos, despacho.
LLM_MODEL_FAST=nvidia/Nemotron-3_5-Lightning

# Fallback global si no se define ningún tier ni override.
LLM_MODEL=

# Override por agente, opcional. Se arma con el nombre del agente en
# mayúsculas. Ejemplo: forzar el gerente a un modelo distinto.
# LLM_MODEL_GERENTE=nvidia/Nemotron-3.5-Super-VL
# Los informes de sector aceptan un override propio: LLM_MODEL_SECTOR.

# Reintentos ante salida JSON inválida (la regla es máx. 2)
LLM_MAX_RETRIES=2
# Segundos que esperamos antes de cortar una llamada
LLM_TIMEOUT_S=90

# === Base de datos ===
# Si no se define, la base vive en backend/data/nexus.db (lo normal).
# NEXUS_DB=

# === Reproducibilidad ===
SIM_SEED=42
