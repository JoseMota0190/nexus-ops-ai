# ============================================================
# Nexus Alarm — variables de entorno
# Copiá este archivo como `.env` y completalo.  NUNCA se commitea `.env`.
# ============================================================

# === Cerebro LLM (TokenFactory de AMD) ===
# true  = respuestas locales, sin llamar a ningún modelo (NO gasta créditos)
# false = usa TokenFactory de verdad (obligatorio para la demo de la hackathon)
USE_MOCK=true

# Endpoint compatible con OpenAI de TokenFactory de AMD.
LLM_BASE_URL=https://notebooks.amd.com/tokenfactory/v1

# Los dos de abajo salen del notebook de notebooks.amd.com/tokenfactory.
# Sin USE_MOCK=false no se usan, pero dejan el archivo listo.
LLM_API_KEY=
LLM_MODEL=

# Reintentos ante salida JSON inválida (la regla es máx. 2)
LLM_MAX_RETRIES=2
# Segundos que esperamos antes de cortar una llamada
LLM_TIMEOUT_S=30

# === Base de datos ===
# Si no se define, la base vive en backend/data/nexus.db (lo normal).
# NEXUS_DB=

# === Evolus (módulo aislado: extractor de documentos + workflow) ===
EVOLUS_ENABLED=false
EVOLUS_API_BASE=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=

# === Reproducibilidad ===
SIM_SEED=42
