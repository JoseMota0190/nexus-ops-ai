# ============================================================
# Nexus Alarm — variables de entorno
# Copiá este archivo como `.env` y completalo.  NUNCA se commitea `.env`.
# ============================================================

# === Cerebro LLM (AMD Radeon Cloud) ===
# true  = respuestas locales, sin llamar a ningún modelo (NO gasta créditos)
# false = usa AMD de verdad (obligatorio para la demo de la hackathon)
USE_MOCK=true

# Endpoint compatible con OpenAI de AMD Radeon Cloud.
# La lista de modelos gratis se ve en https://developer.amd.com.cn/radeon/modelapis
LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# La clave la generás en esa misma página (empieza con "rc-").
# LLM_MODEL debe ser el nombre EXACTO de un modelo del catálogo
# (p. ej. Qwen3.8-27B), o el nombre de Gemma cuando lo despleguemos
# en una instancia propia.
LLM_API_KEY=
LLM_MODEL=

# Reintentos ante salida JSON inválida (la regla es máx. 2)
LLM_MAX_RETRIES=2
# Segundos que esperamos antes de cortar una llamada
LLM_TIMEOUT_S=30

# === Base de datos ===
# Si no se define, la base vive en backend/data/nexus.db (lo normal).
# NEXUS_DB=

# === Evolus (módulo aislado: extractor de documentos + workflow) ===
EVOLUS_ENABLED=false
EVOLUS_API_BASE=https://api.evolus.ai/api/v1
EVOLUS_API_KEY=
EVOLUS_APPLICATION_ID=

# === Reproducibilidad ===
SIM_SEED=42
